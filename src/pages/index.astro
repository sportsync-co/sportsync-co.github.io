---
const site = {
  title: "Sportsync",
  description:
    "Sportsync is building a sports network for athletes, teams, leagues, coaches, referees, scouts and recruiters — combining verified sports profiles, local discovery, recruiting and team operations.",
  org: "sportsync-co",
};

const productAreas = [
  {
    label: "SOCIAL",
    title: "Feed + discovery",
    copy: "A media-forward network for athletes, teams, leagues and sports communities, with profiles built around real sports identity rather than generic followers alone.",
  },
  {
    label: "TRUST",
    title: "Verified sports identity",
    copy: "Performance metrics, roster history, certifications and professional records can retain issuer and evidence provenance instead of collapsing every claim into a generic badge.",
  },
  {
    label: "LOCAL",
    title: "Regional sports boards",
    copy: "Practical metro-area boards for players looking for teams, teams needing players, tryouts, pickup games and staff openings — closer to sports classifieds than an endless global feed.",
  },
  {
    label: "RECRUIT",
    title: "Recruiting + hiring",
    copy: "Structured opportunities for players, coaches, referees, scouts, analysts and performance staff, connected to a living Sportsync résumé and verified history.",
  },
  {
    label: "OPERATE",
    title: "Teams + leagues",
    copy: "Rosters, tryouts, team selection, seasons, divisions, schedules, assignments, availability, RSVPs, attendance, standings and communications in one operating model.",
  },
  {
    label: "COMMUNITY",
    title: "Groups + sports talk",
    copy: "Public and private communities for sports, regions, teams and topics, with explicit promotion policy and the same moderation and translation model as the rest of the platform.",
  },
];

const trustItems = [
  ["SELF-REPORTED", "Useful profile context, clearly labeled as supplied by the account owner."],
  ["VERIFIED USER", "A verified coach, teammate, official or organization can attest allowed claims."],
  ["ORGANIZATION", "Teams, leagues, schools and clubs can certify roster, role and assignment history."],
  ["THIRD PARTY", "Performance labs and integrations can sign structured claims with key and revocation provenance."],
];

const boardExamples = [
  {
    city: "SF BAY AREA",
    boards: ["North Bay", "San Francisco", "East Bay", "South Bay"],
  },
  {
    city: "NEW YORK CITY METRO",
    boards: ["New Jersey", "Staten Island", "Manhattan", "Queens", "Brooklyn", "Bronx"],
  },
];

const roles = [
  "Athletes",
  "Teams",
  "Leagues",
  "Coaches",
  "Assistant coaches",
  "Referees",
  "Scouts",
  "Recruiters",
  "Analysts",
  "Performance staff",
];

const canonical = new URL(Astro.url.pathname, Astro.site ?? "https://sportsync.co");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={site.description} />
    <meta name="theme-color" content="#0b1110" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Sportsync — Find your next team. Build your sports record." />
    <meta property="og:description" content={site.description} />
    <meta property="og:url" content={canonical} />
    <title>Sportsync — Find your next team. Build your sports record.</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <main id="main">
      <header class="masthead">
        <a class="brand" href="/" aria-label="Sportsync home">
          <span class="brand-mark">SS</span>
          <span>Sportsync</span>
        </a>
        <nav class="desktop-nav" aria-label="Primary navigation">
          <a href="#platform">Platform</a>
          <a href="#trust">Verified records</a>
          <a href="#boards">Regional boards</a>
          <a href="#operations">Operations</a>
          <a href={`https://github.com/${site.org}`}>GitHub ↗</a>
          <a href="https://user.sportsync.co/">Log in</a>
          <a class="button-small" href="https://auth.sportsync.co/">Sign up</a>
        </nav>
        <details class="mobile-nav">
          <summary>Menu</summary>
          <nav aria-label="Mobile navigation">
            <a href="#platform">Platform</a>
            <a href="#trust">Verified records</a>
            <a href="#boards">Regional boards</a>
            <a href="#operations">Operations</a>
            <a href={`https://github.com/${site.org}`}>GitHub ↗</a>
            <a href="https://user.sportsync.co/">Log in</a>
            <a href="https://org.sportsync.co/">Organization access</a>
            <a href="https://auth.sportsync.co/">Sign up</a>
          </nav>
        </details>
      </header>

      <section class="hero">
        <div class="hero-copy">
          <p class="eyebrow">THE SPORTS NETWORK + OPERATING SYSTEM</p>
          <h1>Find your next team. Build a sports record people can trust.</h1>
          <p class="lead">
            Sportsync is building one network for sports identity, recruiting, local discovery,
            groups, team and league operations, scheduling, assignments, performance records and
            verified history.
          </p>
          <div class="actions">
            <a class="button" href="#platform">Explore the platform ↓</a>
            <a class="link" href={`https://github.com/${site.org}`}>Follow the build on GitHub ↗</a>
          </div>
          <p class="stage-note">Product under active development · capabilities shown below describe the platform direction and current implementation work.</p>
        </div>

        <aside class="profile-card" aria-label="Example verified athlete profile concept">
          <div class="profile-head">
            <div class="avatar" aria-hidden="true">17</div>
            <div>
              <span class="kicker">ATHLETE PROFILE</span>
              <strong>Maya R.</strong>
              <small>Soccer · winger · Bay Area</small>
            </div>
          </div>
          <div class="metric-grid">
            <div><span>SPRINT</span><strong>4.62 s</strong><small>third-party attested</small></div>
            <div><span>VERTICAL</span><strong>61 cm</strong><small>verified measurement</small></div>
            <div><span>HISTORY</span><strong>3 clubs</strong><small>2 org-attested</small></div>
            <div><span>AVAILABILITY</span><strong>Open</strong><small>Spring 2027</small></div>
          </div>
          <div class="profile-foot">
            <span>Photos + video</span>
            <span>Résumé + attestations</span>
          </div>
        </aside>
      </section>

      <section class="role-strip" aria-label="Sportsync audiences">
        {roles.map((role) => <span>{role}</span>)}
      </section>

      <section class="section" id="platform">
        <div class="section-heading">
          <p class="eyebrow">01 / PLATFORM</p>
          <h2>Social discovery and serious sports operations share one identity graph.</h2>
          <p>
            The same verified profile that appears in a feed can power recruiting, a team roster,
            an officiating assignment or a performance record — without rewriting the person from
            scratch in every tool.
          </p>
        </div>
        <div class="feature-grid">
          {productAreas.map((item) => (
            <article>
              <span>{item.label}</span>
              <h3>{item.title}</h3>
              <p>{item.copy}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="split section-dark" id="trust">
        <div class="split-copy">
          <p class="eyebrow">02 / TRUST BY PROVENANCE</p>
          <h2>A stat is more useful when you know who measured it.</h2>
          <p>
            Sportsync is designed to distinguish self-reported claims from verified-user,
            organization and third-party attestations. Certified records can carry issuer identity,
            signing-key context, evidence digests, timestamps and revocation state.
          </p>
          <p>
            That applies to sprint and jump measurements, roster history, college or semi-pro
            experience, referee and coaching certifications, match participation and other structured
            sports records.
          </p>
        </div>
        <div class="trust-list">
          {trustItems.map(([label, copy], index) => (
            <article>
              <span>{String(index + 1).padStart(2, "0")}</span>
              <div>
                <h3>{label}</h3>
                <p>{copy}</p>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="section" id="boards">
        <div class="section-heading compact">
          <p class="eyebrow">03 / LOCAL SPORTS MARKETPLACE</p>
          <h2>Regional boards built around how people actually cross a metro for sports.</h2>
          <p>
            Players can post that they are looking for a team; teams and leagues can post that they
            need players, staff or officials. One canonical listing can target up to three boards.
            The free baseline is two listings in a rolling 30-day window; paid plans can increase
            quota but do not bypass moderation or duplicate detection.
          </p>
        </div>
        <div class="board-grid">
          {boardExamples.map((metro) => (
            <article>
              <span class="metro-label">{metro.city}</span>
              <div class="board-list">
                {metro.boards.map((board) => <span>{board}</span>)}
              </div>
            </article>
          ))}
        </div>
        <div class="listing-row">
          <span>Looking for a team</span>
          <span>Need players</span>
          <span>Tryouts</span>
          <span>Pickup games</span>
          <span>Coach / staff needed</span>
          <span>Referee assignments</span>
        </div>
      </section>

      <section class="section operations" id="operations">
        <div class="section-heading">
          <p class="eyebrow">04 / TEAM + LEAGUE OPERATIONS</p>
          <h2>From tryout to roster to match day.</h2>
        </div>
        <div class="timeline">
          <article><span>01</span><h3>Recruit</h3><p>Structured opportunities, applications, scouting notes, verified résumés and tryout invites.</p></article>
          <article><span>02</span><h3>Select</h3><p>Tryout scoring, position needs, availability and explainable roster/team-selection assistance.</p></article>
          <article><span>03</span><h3>Schedule</h3><p>Games, practices, tournaments, meetings and assessments with timezone-aware calendars.</p></article>
          <article><span>04</span><h3>Assign</h3><p>Players, coaches, referees, scouts, analysts and staff with availability, RSVP and check-in.</p></article>
          <article><span>05</span><h3>Record</h3><p>Results, standings, performance stats, attendance and attestable assignment/history records.</p></article>
        </div>
      </section>

      <section class="split international">
        <div class="split-copy">
          <p class="eyebrow">05 / INTERNATIONAL BY DESIGN</p>
          <h2>Write once. Review the translations you actually want to publish.</h2>
          <p>
            A post or listing keeps one authoritative source language. Authors can request several
            useful target languages, review machine-generated drafts and approve each translation.
            When the source changes, old translations become stale instead of silently pretending to
            stay authoritative.
          </p>
        </div>
        <div class="language-card">
          <span>SOURCE · ENGLISH</span>
          <strong>Need two midfielders for Sunday league.</strong>
          <div><span>ES</span><small>approved</small></div>
          <div><span>PT</span><small>draft</small></div>
          <div><span>FR</span><small>draft</small></div>
          <div><span>DE</span><small>not requested</small></div>
        </div>
      </section>

      <section class="section reputation">
        <div class="section-heading compact">
          <p class="eyebrow">06 / REPUTATION</p>
          <h2>Talent signals without pretending one opaque number tells the whole story.</h2>
          <p>
            Sport-specific peer evaluation is designed around defined dimensions, qualified context,
            sample size and uncertainty. Voters can be pseudonymous to other users while remaining
            accountable to Sportsync for abuse prevention, vote-ring detection and moderation.
          </p>
        </div>
        <div class="signal-row">
          <span>Verified history</span>
          <span>Performance evidence</span>
          <span>Assignments</span>
          <span>Peer talent dimensions</span>
          <span>References</span>
          <span>Reliability</span>
        </div>
      </section>

      <section class="access" id="access">
        <div>
          <p class="eyebrow">07 / ACCESS</p>
          <h2>One network. Separate user, organization and administrative boundaries.</h2>
        </div>
        <div class="access-grid">
          <a href="https://user.sportsync.co/">
            <span>INDIVIDUALS</span>
            <strong>User application</strong>
            <p>Athlete, coach, referee, scout and other personal Sportsync activity.</p>
            <em>Open user app ↗</em>
          </a>
          <a href="https://org.sportsync.co/">
            <span>ORGANIZATIONS</span>
            <strong>Team + league access</strong>
            <p>Roster, recruiting, schedule, assignment and organization workflows.</p>
            <em>Open organization app ↗</em>
          </a>
          <a href="https://auth.sportsync.co/">
            <span>IDENTITY</span>
            <strong>Create or authenticate an account</strong>
            <p>Authentication is handled through the dedicated identity boundary.</p>
            <em>Continue to auth ↗</em>
          </a>
        </div>
      </section>

      <footer>
        <div>
          <strong>Sportsync</strong>
          <span>Sports network + operations platform</span>
        </div>
        <div class="footer-links">
          <a href={`https://github.com/${site.org}`}>GitHub ↗</a>
          <a href="https://user.sportsync.co/">User app</a>
          <a href="https://org.sportsync.co/">Organization app</a>
        </div>
        <span>{new Date().getFullYear()}</span>
      </footer>
    </main>
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }
  :global(html) { scroll-behavior: smooth; background: #0b1110; }
  :global(body) { margin: 0; color: #ecf2ed; background: #0b1110; font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }
  :global(a) { color: inherit; }
  :global(::selection) { background: #d4ff66; color: #0b1110; }
  :global(:focus-visible) { outline: 3px solid #d4ff66; outline-offset: 4px; }

  .skip-link { position: fixed; left: 1rem; top: 1rem; z-index: 1000; padding: .8rem 1rem; color: #0b1110; background: #d4ff66; transform: translateY(-180%); }
  .skip-link:focus { transform: none; }

  main { --paper: #f0f3ed; --ink: #0b1110; --muted: #9aa69e; --rule: #26302b; --accent: #d4ff66; overflow: hidden; }
  .masthead { position: sticky; top: 0; z-index: 100; display: flex; align-items: center; justify-content: space-between; min-height: 5rem; padding: 0 4vw; gap: 2rem; border-bottom: 1px solid var(--rule); background: color-mix(in srgb, #0b1110 92%, transparent); backdrop-filter: blur(16px); }
  .brand { display: flex; align-items: center; gap: .75rem; font-weight: 800; text-decoration: none; letter-spacing: -.02em; }
  .brand-mark { display: grid; place-items: center; width: 2rem; height: 2rem; color: var(--ink); background: var(--accent); font: 800 .65rem/1 ui-monospace, SFMono-Regular, Menlo, monospace; }
  .desktop-nav { display: flex; align-items: center; gap: clamp(.8rem, 2vw, 1.8rem); font: 650 .68rem/1 ui-monospace, SFMono-Regular, Menlo, monospace; text-transform: uppercase; letter-spacing: .06em; }
  .desktop-nav a { text-decoration: none; padding: .65rem 0; }
  .desktop-nav a:hover { color: var(--accent); }
  .button-small { padding: .75rem .85rem !important; color: var(--ink); background: var(--accent); }
  .mobile-nav { display: none; position: relative; }
  .mobile-nav summary { cursor: pointer; list-style: none; padding: .65rem .8rem; border: 1px solid var(--rule); font: 700 .7rem/1 ui-monospace, monospace; text-transform: uppercase; }
  .mobile-nav summary::-webkit-details-marker { display: none; }
  .mobile-nav nav { position: absolute; right: 0; top: calc(100% + .5rem); display: grid; min-width: 15rem; padding: .75rem; background: #ecf2ed; color: #0b1110; box-shadow: 0 1.5rem 3rem #0007; }
  .mobile-nav a { padding: .75rem; text-decoration: none; }

  .hero { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(22rem, .8fr); min-height: 47rem; border-bottom: 1px solid var(--rule); }
  .hero-copy { display: flex; flex-direction: column; justify-content: center; padding: clamp(5rem, 10vw, 10rem) clamp(2rem, 7vw, 8rem) clamp(4rem, 8vw, 7rem) 4vw; border-right: 1px solid var(--rule); }
  .eyebrow { margin: 0 0 1.5rem; color: var(--accent); font: 800 .68rem/1.4 ui-monospace, SFMono-Regular, Menlo, monospace; letter-spacing: .11em; text-transform: uppercase; }
  h1, h2, h3, p { text-wrap: balance; }
  h1 { max-width: 12ch; margin: 0; font-size: clamp(3.4rem, 7vw, 7.3rem); line-height: .91; letter-spacing: -.07em; font-weight: 730; }
  .lead { max-width: 48rem; margin: 2rem 0 0; color: #aab5ae; font-size: clamp(1.05rem, 1.5vw, 1.3rem); line-height: 1.65; }
  .actions { display: flex; align-items: center; flex-wrap: wrap; gap: 1.4rem; margin-top: 2.5rem; }
  .button { display: inline-flex; padding: 1rem 1.15rem; color: var(--ink); background: var(--accent); text-decoration: none; font: 800 .72rem/1 ui-monospace, monospace; text-transform: uppercase; letter-spacing: .05em; }
  .link { color: #b7c0ba; text-underline-offset: .3rem; font: .75rem/1.3 ui-monospace, monospace; }
  .stage-note { max-width: 45rem; margin: 2rem 0 0; color: #748078; font: .72rem/1.5 ui-monospace, monospace; }

  .profile-card { align-self: center; margin: clamp(2rem, 5vw, 5rem); padding: clamp(1.5rem, 3vw, 2.5rem); border: 1px solid #34413a; background: #111a16; box-shadow: 0 3rem 8rem #0004; }
  .profile-head { display: flex; align-items: center; gap: 1.25rem; padding-bottom: 1.5rem; border-bottom: 1px solid var(--rule); }
  .avatar { display: grid; place-items: center; width: 4.4rem; aspect-ratio: 1; border-radius: 50%; color: var(--ink); background: var(--accent); font: 900 1.2rem/1 ui-monospace, monospace; }
  .profile-head div:last-child { display: grid; gap: .25rem; }
  .profile-head strong { font-size: 1.35rem; }
  .profile-head small, .profile-card small { color: #89968e; }
  .kicker { color: var(--accent); font: 700 .62rem/1 ui-monospace, monospace; letter-spacing: .08em; }
  .metric-grid { display: grid; grid-template-columns: repeat(2, 1fr); }
  .metric-grid div { min-height: 8.5rem; display: flex; flex-direction: column; justify-content: end; gap: .35rem; padding: 1.25rem 0; border-bottom: 1px solid var(--rule); }
  .metric-grid div:nth-child(odd) { padding-right: 1rem; border-right: 1px solid var(--rule); }
  .metric-grid div:nth-child(even) { padding-left: 1rem; }
  .metric-grid span { color: #8a958e; font: .64rem/1 ui-monospace, monospace; }
  .metric-grid strong { font-size: clamp(1.45rem, 2.2vw, 2rem); letter-spacing: -.04em; }
  .profile-foot { display: flex; justify-content: space-between; gap: 1rem; padding-top: 1.4rem; color: #aeb8b1; font: .65rem/1.4 ui-monospace, monospace; }

  .role-strip { display: flex; overflow-x: auto; border-bottom: 1px solid var(--rule); scrollbar-width: none; }
  .role-strip span { flex: 0 0 auto; padding: 1rem 1.6rem; border-right: 1px solid var(--rule); color: #87938b; font: .65rem/1 ui-monospace, monospace; text-transform: uppercase; letter-spacing: .06em; }

  .section { color: var(--ink); background: var(--paper); border-bottom: 1px solid #c9cec9; }
  .section-heading { display: grid; grid-template-columns: minmax(13rem, .5fr) minmax(0, 1.5fr); gap: 3vw; padding: clamp(4rem, 8vw, 8rem) 4vw clamp(2rem, 5vw, 4rem); }
  .section-heading .eyebrow { color: #526054; }
  .section-heading h2 { max-width: 16ch; margin: 0; font-size: clamp(2.4rem, 5vw, 5.2rem); line-height: .98; letter-spacing: -.055em; }
  .section-heading > p:last-child { max-width: 45rem; margin: 1rem 0 0; color: #59645d; font-size: 1.03rem; line-height: 1.65; }
  .section-heading.compact { grid-template-columns: .45fr 1fr 1fr; }

  .feature-grid { display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid #c9cec9; }
  .feature-grid article { min-height: 22rem; padding: clamp(2rem, 4vw, 4rem) 3vw; border-right: 1px solid #c9cec9; border-bottom: 1px solid #c9cec9; }
  .feature-grid article:nth-child(3n) { border-right: 0; }
  .feature-grid span, .metro-label { color: #657167; font: 800 .64rem/1 ui-monospace, monospace; letter-spacing: .08em; }
  .feature-grid h3 { max-width: 12ch; margin: 5rem 0 1rem; font-size: clamp(1.8rem, 2.8vw, 2.8rem); line-height: 1; letter-spacing: -.045em; }
  .feature-grid p { max-width: 32rem; color: #58635b; line-height: 1.65; }

  .split { display: grid; grid-template-columns: minmax(0, .85fr) minmax(0, 1.15fr); border-bottom: 1px solid var(--rule); }
  .section-dark { background: #0e1612; }
  .split-copy { padding: clamp(4rem, 8vw, 8rem) 4vw; border-right: 1px solid var(--rule); }
  .split-copy h2 { max-width: 11ch; margin: 0 0 2rem; font-size: clamp(2.6rem, 5vw, 5.3rem); line-height: .97; letter-spacing: -.06em; }
  .split-copy > p:not(.eyebrow) { max-width: 41rem; color: #9aa69e; line-height: 1.7; }
  .trust-list { display: grid; }
  .trust-list article { display: grid; grid-template-columns: 4rem 1fr; gap: 1.5rem; align-items: start; padding: 2.2rem 4vw; border-bottom: 1px solid var(--rule); }
  .trust-list article:last-child { border-bottom: 0; }
  .trust-list > article > span { color: var(--accent); font: .7rem/1 ui-monospace, monospace; }
  .trust-list h3 { margin: 0 0 .7rem; font-size: 1.25rem; }
  .trust-list p { max-width: 40rem; margin: 0; color: #8e9a92; line-height: 1.6; }

  .board-grid { display: grid; grid-template-columns: repeat(2, 1fr); border-top: 1px solid #c9cec9; }
  .board-grid article { padding: 3rem 4vw; border-right: 1px solid #c9cec9; }
  .board-grid article:last-child { border-right: 0; }
  .board-list { display: flex; flex-wrap: wrap; gap: .65rem; margin-top: 3rem; }
  .board-list span { padding: .85rem 1rem; border: 1px solid #9da79f; font-weight: 700; }
  .listing-row, .signal-row { display: flex; flex-wrap: wrap; border-top: 1px solid #c9cec9; }
  .listing-row span, .signal-row span { flex: 1 1 14rem; padding: 1.25rem 1.5rem; border-right: 1px solid #c9cec9; color: #4e5a51; font: .7rem/1.4 ui-monospace, monospace; }

  .operations { background: #e5e9e1; }
  .timeline { display: grid; grid-template-columns: repeat(5, 1fr); border-top: 1px solid #bcc3bc; }
  .timeline article { min-height: 21rem; padding: 2rem; border-right: 1px solid #bcc3bc; }
  .timeline article:last-child { border-right: 0; }
  .timeline span { font: 800 .7rem/1 ui-monospace, monospace; }
  .timeline h3 { margin: 6rem 0 1rem; font-size: 1.6rem; }
  .timeline p { color: #5d675f; line-height: 1.6; }

  .international { background: #121a16; }
  .language-card { align-self: center; margin: clamp(2rem, 6vw, 6rem); padding: 2rem; border: 1px solid #334039; }
  .language-card > span { color: var(--accent); font: .66rem/1 ui-monospace, monospace; }
  .language-card > strong { display: block; margin: 1.4rem 0 2.2rem; font-size: clamp(1.5rem, 2.5vw, 2.5rem); letter-spacing: -.04em; }
  .language-card div { display: flex; justify-content: space-between; padding: 1rem 0; border-top: 1px solid var(--rule); }
  .language-card div span { font: 800 .75rem/1 ui-monospace, monospace; }
  .language-card small { color: #8e9992; }

  .reputation { background: #f2f2e9; }
  .access { display: grid; grid-template-columns: .65fr 1.35fr; gap: 3vw; padding: clamp(4rem, 8vw, 8rem) 4vw; background: #0b1110; border-bottom: 1px solid var(--rule); }
